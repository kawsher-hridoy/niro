# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# --- AI provider selection ---
# One of: azure | claude | gemini
AI_PROVIDER=azure

# --- Azure OpenAI (current) ---
AZURE_OPENAI_ENDPOINT=https://ai-for-security.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-chat-latest
AZURE_OPENAI_KEY=replace-me

# --- Claude (fallback) ---
# ANTHROPIC_API_KEY=

# --- Gemini (fallback) ---
# GOOGLE_API_KEY=

# --- App ---
APP_ENV=dev
APP_SECRET=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL=postgresql://niro:niro@localhost:5432/niro

# --- File storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./niro/uploads

# --- Audit log retention (days) ---
AUDIT_RETENTION_DAYS=365
